    "\u05A2", "\u05A3", "\u05A4", "\u05A5", "\u05A6", "\u05A7",
    "\u05AA", "\u05C5", "\u0655", "\u0656", "\u065C", "\u065F",
    "\u06E3", "\u06EA", "\u06ED", "\u0731", "\u0734", "\u0737",
    "\u0738", "\u0739", "\u073B", "\u073C", "\u073E", "\u0742",
    "\u0744", "\u0746", "\u0748", "\u07F2", "\u07FD", "\u0859",
    "\u085A", "\u085B", "\u0952", "\u0F18", "\u0F19", "\u0F35",
    "\u0F37", "\u0FC6", "\u108D", "\u193B", "\u1A18", "\u1A7F",
    "\u1B6C", "\u1CD7", "\u1CD9", "\u1CDC", "\u1CDD", "\u1DC2",
    "\u1DCA", "\u1DCF", "\u1DFF", "\u20E8", "\u20EC", "\u20ED",
    "\u20EE", "\u20EF", "\uA92B", "\uA92C", "\uA92D", "\uAAB4",
    "\uFE27", "\uFE28", "\uFE29", "\uFE2A", "\uFE2B", "\uFE2C",
    "\uFE2D"
]


def zalgo(text: str, intensity: int = 4) -> str:
    results = []
    for char in text:
        results.append(char)
        
        if char.isspace():
            continue

        for _ in range(random.randint(1, intensity)):
            results.append(random.choice(ABOVE))
            results.append(random.choice(BELOW))

    return "".join(results)


def main() -> None:
    if len(sys.argv) != 2:
        print(f"usage: {__file__} <string>")
        return

    print(2 * "\n")
    print(zalgo(sys.argv[1]))
    print(2 * "\n")


if __name__ == '__main__':
    main()
