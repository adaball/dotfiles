BELOW = [
    "\u0316", "\u0317", "\u0318", "\u0319", "\u031C", "\u031D",
    "\u031E", "\u031F", "\u0320", "\u0323", "\u0324", "\u0325",
    "\u0326", "\u0329", "\u032A", "\u032B", "\u032C", "\u032D",
