    "\u034A", "\u034B", "\u034C", "\u0350", "\u0351", "\u0352",
    "\u0357", "\u035B", "\u0363", "\u0364", "\u0365", "\u0366",
    "\u0367", "\u0368", "\u0369", "\u036A", "\u036B", "\u036C",
